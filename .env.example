# Copy to .env and fill in. .env is gitignored. Never commit real tokens.

# --- Bright Data ---
BRIGHTDATA_TOKEN=bd_xxxxxxxxxxxxxxxxxxxx
# Your Web Unlocker zone name exactly as it appears in the dashboard (often web_unlocker
# or mcp_unlocker). A wrong zone name returns empty 200s rather than an obvious error, and
# so does a zone whose IP allowlist no longer matches your current address (home IPs rotate,
# and IPv4 vs IPv6 counts as a different address). For a pipeline, leave the allowlist off
# and let the token be the credential, or your scheduled runs break when the IP moves.
WEB_UNLOCKER_ZONE=web_unlocker
# SERP zone, only needed for hybrid live retrieval (src/web_kb/live_tool.py):
SERP_ZONE=serp_api
# Only needed for the Crawl API scaling path (scripts use Web Unlocker by default):
CRAWL_DATASET_ID=

# --- AWS / S3 ---
# Credentials come from the standard boto3 chain. To use a named profile without exporting
# it in every shell, set AWS_PROFILE here; boto3 reads it from the environment.
# AWS_PROFILE=your-profile
AWS_REGION=us-east-1
S3_BUCKET=web-kb-corpus-111122223333
S3_PREFIX=docs

# --- Bedrock knowledge base ---
# Titan Text Embeddings V2 is the default; override to use a different embedding model.
EMBEDDING_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0
# Answer model for RetrieveAndGenerate (any Bedrock text model you have access to).
# Nova 2 Lite is the current cost-efficient default; swap in whatever your account runs.
GENERATION_MODEL_ARN=arn:aws:bedrock:us-east-1:111122223333:inference-profile/us.amazon.nova-2-lite-v1:0
# The KB service role (create it from infra/, see README):
KB_ROLE_ARN=arn:aws:iam::111122223333:role/bedrock-web-kb-role

# --- Vector store: S3 Vectors path (default) ---
S3_VECTOR_BUCKET_ARN=arn:aws:s3vectors:us-east-1:111122223333:bucket/web-kb-vectors
S3_VECTOR_INDEX_NAME=web-kb-index
# --- Vector store: OpenSearch Serverless path (alternative; use --store opensearch) ---
OPENSEARCH_COLLECTION_ARN=

# --- Set after running scripts/2_create_kb.py, then paste back here ---
KNOWLEDGE_BASE_ID=
DATA_SOURCE_ID=
